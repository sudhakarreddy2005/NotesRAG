# ==============================================================================
# NotesRAG Environment Configuration
# ==============================================================================

# Required: Groq API Key for fast LLM inference
# Obtain your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: LLM Model to use on Groq
# Recommended options:
# - llama-3.3-70b-versatile (high performance, smart reasoning)
# - llama-3.1-8b-instant (ultra low latency, lightweight)
# - mixtral-8x7b-32768 (long context window)
# - openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# Optional: Embedding model from Hugging Face Sentence Transformers
# Default: all-MiniLM-L6-v2
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional: Hugging Face User Access Token (to avoid rate limits on model download)
# HF_TOKEN=your_huggingface_token_here
