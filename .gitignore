# ==============================================================================
# NotesRAG — Comprehensive .gitignore
# ==============================================================================

# Dependencies & Package Managers
node_modules/
frontend/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & Frontend Build Outputs
.next/
out/
build/
dist/
wheels/
*.egg-info/
*.tsbuildinfo
next-env.d.ts
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# Vercel Deployment Metadata
.vercel/
frontend/.vercel/

# Logs & Debugging Artifacts
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Python Bytecode & Packaging
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
.coverage.*
coverage/
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Python Virtual Environments
.venv/
venv/
ENV/
env/
.uv/

# Environment Variables & Secrets
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.pem
*.key
*.cert
*.crt

# Vector Store Databases, Indexes & Serializations (Runtime Artifacts)
faiss_store/
data/vector_store/
chroma/
chroma_db/
*.index
*.pkl
*.sqlite
*.sqlite3
*.db
*.parquet

# User Uploaded Documents (Keep folder structure via .gitkeep)
data/pdf/*
!data/pdf/.gitkeep
data/text_files/*
!data/text_files/.gitkeep
data/uploads/

# IDEs, Editors & AI Agent Caches
.vscode/
.idea/
.kilo/
*.swp
*.swo
*~
.gemini/
.agents/
.aider*
.cursor/
.windsurf/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*-checkpoint.ipynb

# Operating System & Temporary Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.tmp
*.temp
*.bak
